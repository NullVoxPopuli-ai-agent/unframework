---
import type { HTMLAttributes } from "astro/types";
import "./Chip.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"button">, "label" | "variant" | "pressed"> {
  label: string;
  variant?: "neutral" | "danger";
  pressed?: boolean;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  label,
  variant = "neutral",
  pressed = false,
  class: className,
  style,
  type = "button",
  "data-variant": dataVariant,
  "data-state": dataState,
  "aria-pressed": ariaPressed,
  ...attrs
} = Astro.props;
---

<button
  type={type}
  class:list={["chip", className]}
  data-variant={dataVariant ?? variant}
  data-state={dataState ?? (pressed ? "on" : "off")}
  aria-pressed={ariaPressed ?? (pressed ? "true" : "false")}
  style={style}
  data-uf-69db3802=""
  {...attrs}
>{label}</button>
