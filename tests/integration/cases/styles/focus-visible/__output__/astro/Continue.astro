---
import type { HTMLAttributes } from "astro/types";
import "./Continue.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"button">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, type = "button", ...attrs } = Astro.props;
---

<button
  type={type}
  class:list={["continue", className]}
  style={style}
  data-uf-bb3adc28=""
  {...attrs}
>{text}</button>
