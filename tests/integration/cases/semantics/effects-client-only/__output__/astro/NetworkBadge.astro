---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"p"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  class: className,
  style,
  role = "status",
  "data-checked": dataChecked,
  ...attrs
} = Astro.props;

const online = undefined as boolean | undefined;
const label = "Checking the connection" as string;
---

<p
  class:list={["network-badge", className]}
  role={role}
  data-checked={dataChecked ?? (online === undefined ? "no" : "yes")}
  style={style}
  {...attrs}
>{label}</p>
