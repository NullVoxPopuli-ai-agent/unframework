---
import { useTracked } from "./useTracked";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Timeline", ...attrs } = Astro.props;

const entries = [] as string[];
const { count } = useTracked();
---

<section class:list={["timeline", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <p role="status">Count: {count}</p>
  <button type="button">Increment</button>
  <ol>
    {entries.map((entry) => (
      <li>{entry}</li>
    ))}
  </ol>
</section>
