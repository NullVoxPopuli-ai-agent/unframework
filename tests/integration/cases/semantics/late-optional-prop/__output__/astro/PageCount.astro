---
import type { HTMLAttributes } from "astro/types";

export interface PageCountProps {
  page?: number;
  total: number;
}

interface Props extends PageCountProps, Omit<HTMLAttributes<"nav">, "page" | "total"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  page = 1,
  total,
  class: className,
  style,
  "aria-label": ariaLabel = "Pages",
  ...attrs
} = Astro.props;

const label = `Page ${page} of ${total}`;
---

<nav class:list={["page-count", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <p role="status">{label}</p>
  <p>Direct: {page}</p>
</nav>
