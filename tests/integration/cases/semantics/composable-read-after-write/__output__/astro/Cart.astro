---
import { useCart } from "./useCart";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Cart", ...attrs } = Astro.props;

const { items } = useCart();
---

<section class:list={["cart", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <p role="status">Items: {items}</p>
  <button type="button">Add three</button>
  <button type="button">Clear</button>
</section>
