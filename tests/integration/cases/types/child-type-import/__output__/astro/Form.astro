---
import Field, { type FieldProps } from "./Field.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"form">, "field"> {
  field: FieldProps;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  field,
  class: className,
  style,
  "aria-label": ariaLabel = "Sign up",
  ...attrs
} = Astro.props;
---

<form aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <Field name={field.name} label={field.label} />
</form>
