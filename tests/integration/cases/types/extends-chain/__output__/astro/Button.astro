---
import type { ButtonProps } from "./types";
import type { HTMLAttributes } from "astro/types";

interface Props extends ButtonProps, Omit<HTMLAttributes<"button">, "disabled" | "label" | "id"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  id,
  label,
  disabled = false,
  class: className,
  style,
  type = "button",
  ...attrs
} = Astro.props;
---

<button
  id={id}
  type={type}
  disabled={disabled}
  class:list={[className]}
  style={style}
  {...attrs}
>{label}</button>
