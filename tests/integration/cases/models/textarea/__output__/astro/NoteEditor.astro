---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Note", ...attrs } = Astro.props;

const note = "Buy milk" as string;
---

<section aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <textarea aria-label="Text">{note}</textarea>
  <output>{note.length} characters</output>
  <button type="button">Discard</button>
</section>
