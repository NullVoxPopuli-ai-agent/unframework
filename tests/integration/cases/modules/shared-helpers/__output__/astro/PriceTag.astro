---
import { formatPrice, pluralise } from "./format";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "cents"> {
  cents: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { cents, class: className, style, "aria-label": ariaLabel = "Price", ...attrs } = Astro.props;

const quantity = 1 as number;
const total = formatPrice(cents * quantity);
---

<section class:list={["price-tag", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <p>Each: {formatPrice(cents)}</p>
  <p role="status">{pluralise(quantity, "item")}: {total}</p>
  <button type="button">One more</button>
  <button type="button">Order</button>
</section>
