---
import Display from "./Display.astro";
import type { HTMLAttributes } from "astro/types";

export type CountKey = number;

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Counter", ...attrs } = Astro.props;
---

<section aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <Display />
  <button type="button">Add one</button>
</section>
