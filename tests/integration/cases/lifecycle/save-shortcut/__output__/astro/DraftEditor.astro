---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Draft", ...attrs } = Astro.props;

const saves = 0 as number;
---

<section class:list={["draft-editor", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <label>Draft<textarea name="draft"></textarea></label>
  <p role="status">Saved: {saves}</p>
</section>
