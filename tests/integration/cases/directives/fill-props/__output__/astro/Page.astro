---
import Picker from "./Picker.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Page", ...attrs } = Astro.props;
---

<section class:list={["page", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <Picker option={({ option }) => <span data-name={`option-${option.id}`}>{option.label}</span>} />
</section>
