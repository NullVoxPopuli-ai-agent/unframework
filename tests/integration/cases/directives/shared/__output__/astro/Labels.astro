---
import Badge from "./Badge.astro";
import Tag from "./Tag.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Labels", ...attrs } = Astro.props;
---

<section class:list={["labels", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <Badge label="New" />
  <Tag name="docs" />
</section>
