---
import Rows from "./Rows.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Rows", ...attrs } = Astro.props;
---

<section class:list={["wrapper", className]} aria-label={ariaLabel} style={style} {...attrs}>
  {Astro.slots.has("row") ? (
    <Rows>
      <slot name="row" slot="row" />
    </Rows>
  ) : (
    <Rows />
  )}
</section>
