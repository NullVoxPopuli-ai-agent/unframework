---
import Toast from "./Toast.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Inbox", ...attrs } = Astro.props;

const shown = true as boolean;
---

<section aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <button type="button">{shown ? "Hide" : "Show"}</button>
  {shown ? (
    <Toast />
  ) : null}
</section>
