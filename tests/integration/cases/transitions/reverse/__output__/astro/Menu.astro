---
import type { HTMLAttributes } from "astro/types";
import "./Menu.uf.tsx.css";

interface Props extends HTMLAttributes<"nav"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Account", ...attrs } = Astro.props;

const open = true as boolean;
const refreshes = 0 as number;
---

<nav
  class:list={["menu", className]}
  aria-label={ariaLabel}
  style={style}
  data-uf-e688a71a=""
  {...attrs}
>
  <button type="button" aria-expanded={open} data-uf-e688a71a="">Refresh</button>
  <p role="status" data-uf-e688a71a="">Refreshes: {refreshes}</p>
  {open ? (
    <ul class="items" data-uf-e688a71a="">
      <li data-uf-e688a71a="">Profile</li>
    </ul>
  ) : null}
</nav>
