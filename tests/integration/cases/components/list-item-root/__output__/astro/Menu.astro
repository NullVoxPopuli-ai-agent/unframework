---
import Item from "./Item.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"ul">, "entries"> {
  entries: string[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  entries,
  class: className,
  style,
  "aria-label": ariaLabel = "Menu",
  ...attrs
} = Astro.props;
---

<ul aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  {entries.map((entry) => (
    <Item label={entry} />
  ))}
</ul>
