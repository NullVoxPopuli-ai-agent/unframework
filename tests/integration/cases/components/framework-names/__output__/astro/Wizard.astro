---
import KeepAlive from "./KeepAlive.astro";
import Transition from "./Transition.astro";
import TransitionComponent from "./TransitionComponent.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Wizard", ...attrs } = Astro.props;
---

<section aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <Transition step="details" />
  <TransitionComponent />
  <KeepAlive level={2} />
</section>
