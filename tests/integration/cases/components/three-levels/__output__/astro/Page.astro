---
import Section from "./Section.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"article">, "name"> {
  name: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  name,
  class: className,
  style,
  "aria-label": ariaLabel = "Profile",
  ...attrs
} = Astro.props;
---

<article aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <Section title={`About ${name}`} body="Three components deep." />
  <Section title="Contact" body={`Write to ${name}.`} />
</article>
