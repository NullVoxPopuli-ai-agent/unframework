---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"p">, "text" | "tone"> {
  text: string;
  tone: "info" | "quiet";
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, tone, class: className, style, role = "status", ...attrs } = Astro.props;
---

<p role={role} class:list={["notice", tone, className]} style={style} {...attrs}>{text}</p>
