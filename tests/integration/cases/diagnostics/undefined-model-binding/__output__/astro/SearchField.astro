---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "query"> {
  query?: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  query,
  class: className,
  style,
  type = "search",
  "aria-label": ariaLabel = "Search",
  ...attrs
} = Astro.props;
---

<input
  type={type}
  aria-label={ariaLabel}
  value={query}
  class:list={[className]}
  style={style}
  {...attrs}
/>
