---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "picked"> {
  picked?: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { picked = "", class: className, style, type = "button", ...attrs } = Astro.props;
---

<button type={type} class:list={[className]} style={style} {...attrs}>Yes ({picked})</button>
