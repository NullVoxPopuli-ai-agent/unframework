---
import { useControllableState } from "./useControllableState";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "value"> {
  value?: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  value,
  class: className,
  style,
  "aria-label": ariaLabel = "Rating",
  ...attrs
} = Astro.props;

const { current } = useControllableState(() => value, 1);
---

<section class:list={["rating", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <p role="status">Rated {current} of 3</p>
  <button type="button">Two</button>
  <button type="button">Three</button>
</section>
