---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Messages", ...attrs } = Astro.props;

const messages = ["Welcome to the team"];
---

<section class:list={["message-list", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <ul>
    {messages.map((message) => (
      <li>{message}</li>
    ))}
  </ul>
  <button type="button">Add a message</button>
</section>
