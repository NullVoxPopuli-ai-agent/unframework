---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Search", ...attrs } = Astro.props;

const status = "Loading" as string;
const results = [] as string[];
const doubled = 0 as number;
---

<section class:list={["search-results", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <p>{status}</p>
  <label>Query<input name="query" /></label>
  <ul aria-label="Results">
    {results.map((result) => (
      <li>{result}</li>
    ))}
  </ul>
  <output>{doubled}</output>
  <button type="button">Add one</button>
</section>
