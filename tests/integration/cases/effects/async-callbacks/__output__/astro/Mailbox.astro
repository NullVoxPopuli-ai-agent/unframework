---
import type { HTMLAttributes } from "astro/types";

export interface MailboxProps {
  folder: string;
}

interface Props extends MailboxProps, Omit<HTMLAttributes<"section">, "folder"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  folder: _folder,
  class: className,
  style,
  "aria-label": ariaLabel = "Mailbox",
  ...attrs
} = Astro.props;

const name = "Loading" as string;
const status = "idle" as string;
const summary = "No messages" as string;
---

<section class:list={["mailbox", className]} aria-label={ariaLabel} style={style} {...attrs}>
  <h2>{name}</h2>
  <p role="status">{summary}</p>
  <p>Status: {status}</p>
  <button type="button">Save</button>
  <button type="button">Refresh every second</button>
  <button type="button">Mark all read</button>
  <button type="button">Note</button>
</section>
