---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, type = "button", ...attrs } = Astro.props;
---

<button type={type} class:list={[className]} style={style} {...attrs}>Charge</button>
