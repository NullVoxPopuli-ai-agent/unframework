---
import Chart from "./Chart.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Report", ...attrs } = Astro.props;

const open = false as boolean;
---

<section aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <button type="button">Show the chart</button>
  {open ? (
    <Chart />
  ) : null}
</section>
