---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "label"> {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  label,
  class: className,
  style,
  name = "name",
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<input
  name={name}
  aria-label={ariaLabel ?? label}
  class:list={[className]}
  style={style}
  {...attrs}
/>
