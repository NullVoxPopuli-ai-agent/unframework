---
import NameField from "./NameField.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"form"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Profile", ...attrs } = Astro.props;
---

<form aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <NameField label="Name" />
  <button type="button">Edit name</button>
</form>
