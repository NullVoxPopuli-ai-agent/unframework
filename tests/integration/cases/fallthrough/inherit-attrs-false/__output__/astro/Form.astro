---
import Field from "./Field.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"form"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel = "Sign up", ...attrs } = Astro.props;
---

<form aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <Field label="Email" />
  <Field label="Name" />
</form>
