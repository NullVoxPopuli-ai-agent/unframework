---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "title"> {
  title: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, class: className, style, type = "button", ...attrs } = Astro.props;
---

<button type={type} class:list={["button", className]} style={style} {...attrs}>{title}</button>
