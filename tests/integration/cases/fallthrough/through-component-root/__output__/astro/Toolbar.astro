---
import Primary from "./Primary.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  class: className,
  style,
  role = "toolbar",
  "aria-label": ariaLabel = "Actions",
  ...attrs
} = Astro.props;

const clicks = 0 as number;
---

<div role={role} aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  <Primary text="Save" id="save" aria-label="Save draft" />
  <button type="button">Focus save</button>
  <p>Clicks: {clicks}</p>
</div>
