---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "label"> {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  label,
  class: className,
  style,
  role = "note",
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<div
  role={role}
  aria-label={ariaLabel ?? label}
  class:list={["notice", className]}
  style={style}
  {...attrs}
>
  <p>
    <slot>
      <em>Nothing to report.</em>
    </slot>
  </p>
  <slot name="action">
    <span class="muted">No action</span>
  </slot>
</div>
