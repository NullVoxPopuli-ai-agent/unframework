---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"ul">, "names" | "default"> {
  names: string[];
  default?: (props: { item: string }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  names,
  default: defaultSlot,
  class: className,
  style,
  "aria-label": ariaLabel = "Names",
  ...attrs
} = Astro.props;
---

<ul aria-label={ariaLabel} class:list={[className]} style={style} {...attrs}>
  {names.map((item) => (
    <li>{defaultSlot?.({ item })}</li>
  ))}
</ul>
