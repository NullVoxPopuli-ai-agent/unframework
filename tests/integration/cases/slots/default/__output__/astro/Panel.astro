---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "title"> {
  title: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<section class:list={["panel", className]} aria-label={ariaLabel ?? title} style={style} {...attrs}>
  <h2>{title}</h2>
  <slot />
</section>
