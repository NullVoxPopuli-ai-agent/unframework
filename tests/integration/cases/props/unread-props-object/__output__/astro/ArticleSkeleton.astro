---
import type { HTMLAttributes } from "astro/types";

export interface ArticleSkeletonProps {
  title: string;
  summary?: string;
  minutes?: number;
}

interface Props
  extends ArticleSkeletonProps, Omit<HTMLAttributes<"article">, "title" | "summary" | "minutes"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  title: _title,
  summary: _summary,
  minutes: _minutes,
  class: className,
  style,
  "aria-busy": ariaBusy = "true",
  "aria-label": ariaLabel = "Loading article",
  ...attrs
} = Astro.props;
---

<article
  class:list={["article-skeleton", className]}
  aria-busy={ariaBusy}
  aria-label={ariaLabel}
  style={style}
  {...attrs}
>
  <p>Loading the article</p>
</article>
